# Node.js 24+. Create the bot with @BotFather and add it to your public supergroup.
TELEGRAM_BOT_TOKEN=123456:replace_with_botfather_token
TELEGRAM_CHAT=@your_public_group
# Public group NIP-19 address, independent of any client or website.
PUBLIC_GROUP=naddr1replace_me
# Full share links also work, but must be quoted if they contain #.
RELAYS=wss://relay.damus.io,wss://nos.lol
# Optional existing bot identity. Otherwise generated once and saved in data/state.json.
NSEC=
# Optional absolute path. Defaults to this example's data directory.
DATA_DIR=
